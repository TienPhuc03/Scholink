# ============================================================================
# 1. CỔNG GIAO TIẾP & ĐỊNH TUYẾN (API GATEWAY HTTP & MICROSERVICES)
# ============================================================================
NODE_ENV=development
GATEWAY_PORT=3000
IDENTITY_SERVICE_PORT=3001
OPPORTUNITY_SERVICE_PORT=3002
COLLABORATION_SERVICE_PORT=3003
BILLING_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

# Microservices Reverse Proxy Target URLs (for API Gateway HTTP dispatch)
IDENTITY_SERVICE_URL=http://localhost:3001
OPPORTUNITY_SERVICE_URL=http://localhost:3002
COLLABORATION_SERVICE_URL=http://localhost:3003
BILLING_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005

# High-Load gRPC Binary Stream Ports & URLs (East-West Traffic)
IDENTITY_GRPC_PORT=50051
IDENTITY_GRPC_URL=localhost:50051
OPPORTUNITY_GRPC_PORT=50052
OPPORTUNITY_GRPC_URL=localhost:50052
COLLABORATION_GRPC_PORT=50053
COLLABORATION_GRPC_URL=localhost:50053
BILLING_GRPC_PORT=50054
BILLING_GRPC_URL=localhost:50054
NOTIFICATION_GRPC_PORT=50055
NOTIFICATION_GRPC_URL=localhost:50055

# ============================================================================
# 2. CƠ SỞ DỮ LIỆU MONGODB 7 (5 DATABASE CÔ LẬP THEO SERVICE)
# ============================================================================
MONGODB_URI=mongodb://localhost:27017
IDENTITY_DB_NAME=scholink_identity
OPPORTUNITY_DB_NAME=scholink_opportunity
COLLABORATION_DB_NAME=scholink_collaboration
BILLING_DB_NAME=scholink_billing
NOTIFICATION_DB_NAME=scholink_notification

# ============================================================================
# 3. REDIS 7 (IDEMPOTENCY KEY, SESSION REVOCATION, OTP & CACHE)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================================================
# 4. BẢO MẬT, JWT & MÃ HÓA (BẮT BUỘC CẤU HÌNH TRONG .env, TỐI THIỂU 32 KÝ TỰ)
# ============================================================================
JWT_SECRET=scholink-super-secret-jwt-key-minimum-32-chars-long!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=scholink-pii-secret-encryption-key-32ch!

# ============================================================================
# 5. OBJECT STORAGE (MINIO S3 - BUCKET RIÊNG TƯ)
# ============================================================================
MINIO_ENDPOINT=localhost
MINIO_PUBLIC_ENDPOINT=10.0.2.2
MINIO_PORT=9000
MINIO_ACCESS_KEY=scholink_minio_admin
MINIO_SECRET_KEY=scholink_minio_password
MINIO_BUCKET=scholink-documents

# ============================================================================
# 6. MESSAGE BROKER (RABBITMQ OUTBOX & EMQX MQTT REALTIME)
# ============================================================================
RABBITMQ_URI=amqp://guest:guest@localhost:5672
MQTT_BROKER_URL=mqtt://localhost:1883
