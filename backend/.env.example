# ============================================================================
# 1. CỔNG GIAO TIẾP (API GATEWAY HTTP & MICROSERVICES gRPC)
# ============================================================================
NODE_ENV=development
GATEWAY_PORT=3000

# Địa chỉ lắng nghe và kết nối gRPC nội bộ giữa API Gateway <-> 5 Microservices
IDENTITY_GRPC_URL=localhost:50051
OPPORTUNITY_GRPC_URL=localhost:50052
COLLABORATION_GRPC_URL=localhost:50053
BILLING_GRPC_URL=localhost:50054
NOTIFICATION_GRPC_URL=localhost:50055

# ============================================================================
# 2. CƠ SỞ DỮ LIỆU MONGODB 7 (5 DATABASE CÔ LẬP THEO SERVICE)
# ============================================================================
MONGODB_URI=mongodb://localhost:27017
IDENTITY_DB_NAME=scholink_identity
OPPORTUNITY_DB_NAME=scholink_opportunity
COLLABORATION_DB_NAME=scholink_collaboration
BILLING_DB_NAME=scholink_billing
NOTIFICATION_DB_NAME=scholink_notification

# ============================================================================
# 3. REDIS 7 (IDEMPOTENCY KEY, SESSION REVOCATION, OTP & CACHE)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================================================
# 4. BẢO MẬT, JWT & MÃ HÓA (BẮT BUỘC CẤU HÌNH TRONG .env, TỐI THIỂU 32 KÝ TỰ)
# ============================================================================
JWT_SECRET=<REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_JWT_SECRET>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=<REPLACE_WITH_AT_LEAST_32_CHARS_AES_SECRET_KEY>

# ============================================================================
# 5. OBJECT STORAGE (MINIO S3 - BUCKET RIÊNG TƯ)
# ============================================================================
MINIO_ENDPOINT=localhost
MINIO_PUBLIC_ENDPOINT=10.0.2.2
MINIO_PORT=9000
MINIO_ACCESS_KEY=<REPLACE_WITH_MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<REPLACE_WITH_MINIO_SECRET_KEY>
MINIO_BUCKET=scholink-documents

# ============================================================================
# 6. MESSAGE BROKER (RABBITMQ OUTBOX & EMQX MQTT REALTIME)
# ============================================================================
RABBITMQ_URI=amqp://guest:guest@localhost:5672
MQTT_BROKER_URL=mqtt://localhost:1883
