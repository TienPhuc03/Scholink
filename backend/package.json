{
  "name": "scholink-backend",
  "version": "1.0.0",
  "description": "Scholink Microservices Ecosystem - Nền tảng học bổng và cuộc thi sinh viên",
  "author": "Scholink Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build gateway",
    "build:all": "nest build gateway && nest build identity-service && nest build opportunity-service && nest build collaboration-service && nest build billing-service && nest build notification-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start gateway",
    "start:gateway": "nest start gateway --watch",
    "start:identity": "nest start identity-service --watch",
    "start:opportunity": "nest start opportunity-service --watch",
    "start:collaboration": "nest start collaboration-service --watch",
    "start:billing": "nest start billing-service --watch",
    "start:notification": "nest start notification-service --watch",
    "seed": "ts-node scripts/seed.ts",
    "backup": "ts-node scripts/backup.ts",
    "restore": "ts-node scripts/restore.ts",
    "test:e2e": "ts-node scripts/test-e2e.ts",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@grpc/reflection": "^1.0.4",
    "@nestjs/common": "^11.0.10",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.10",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.2.7",
    "@nestjs/mongoose": "^11.0.1",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/swagger": "^11.0.6",
    "bcryptjs": "^3.0.2",
    "ioredis": "^5.6.0",
    "mongoose": "^8.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.4",
    "@nestjs/schematics": "^11.0.1",
    "@nestjs/testing": "^11.0.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "apps/**/*.(t|j)s",
      "libs/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@shared$": "<rootDir>/libs/shared/src/index",
      "^@shared/(.*)$": "<rootDir>/libs/shared/src/$1"
    }
  }
}
