# API Gateway & Microservices Ports
GATEWAY_PORT=3000
IDENTITY_SERVICE_PORT=3001
OPPORTUNITY_SERVICE_PORT=3002
COLLABORATION_SERVICE_PORT=3003
BILLING_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

# Microservices Reverse Proxy Target URLs (for API Gateway)
IDENTITY_SERVICE_URL=http://localhost:3001
OPPORTUNITY_SERVICE_URL=http://localhost:3002
COLLABORATION_SERVICE_URL=http://localhost:3003
BILLING_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005

NODE_ENV=development

# Database (MongoDB 7 Base Connection)
MONGODB_URI=mongodb://localhost:27017

# Microservices Isolated Database Names
IDENTITY_DB_NAME=scholink_identity
OPPORTUNITY_DB_NAME=scholink_opportunity
COLLABORATION_DB_NAME=scholink_collaboration
BILLING_DB_NAME=scholink_billing
NOTIFICATION_DB_NAME=scholink_notification

# Redis (Session, Cache, Idempotency)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication (RS256 / HS256)
JWT_SECRET=scholink-super-secret-jwt-key-minimum-32-chars-long!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Key (AES-256-GCM for PII)
ENCRYPTION_KEY=scholink-pii-secret-encryption-key-32ch!

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=scholink_minio_admin
MINIO_SECRET_KEY=scholink_minio_password
MINIO_BUCKET=scholink-documents

# RabbitMQ (Event Bus & Outbox)
RABBITMQ_URI=amqp://guest:guest@localhost:5672

# Realtime (MQTT Broker)
MQTT_BROKER_URL=mqtt://localhost:1883
